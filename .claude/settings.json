{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node_modules/.bin/design-hub hook md-writing",
            "timeout": 10,
            "statusMessage": "Checking Markdown edit"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node_modules/.bin/design-hub hook fidelity-guard",
            "timeout": 15,
            "statusMessage": "Fidelity guard"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node_modules/.bin/design-hub hook skill-hint",
            "timeout": 5,
            "statusMessage": "Skill hint"
          }
        ]
      }
    ]
  }
}
