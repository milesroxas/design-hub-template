# Written by `pnpm bootstrap`: the dev server's port, checked free on this
# machine at the time. Never commit .env.
PORT=

# Password gate for the deployed prototypes (proxy.ts). Set both in the Vercel
# project's Environment Variables for Production and Preview; `pnpm bootstrap
# --vercel <project>` does it. Never commit values.
# GATE_PASSWORD: what a reviewer types. Rotating it signs every visitor out.
GATE_PASSWORD=
# GATE_SECRET: 32+ random bytes, base64 or hex (openssl rand -base64 32). Signs the
# session cookie so a password guess cannot be turned into a forged cookie.
GATE_SECRET=

# Optional: TypeSafe's Jev checks (the fidelity guard, the pre-flight, comment
# triage, the skill hint). Set by `pnpm bootstrap --typesafe-key <key>`. Only this
# file turns it on, never a key in the shell. Absent, every Jev question is skipped.
TYPESAFE_API_KEY=

# Optional: the review store (comments and people) on the deployed site.
# `pnpm bootstrap --vercel <project> --review` adds Upstash Redis through the
# Vercel Marketplace and copies these two here, so `pnpm comments` and
# `pnpm people` reach the same store. Absent, they use the local dev store.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: `pnpm fixtures-pull` reads a Webflow CMS collection with a site
# token that has the cms:read scope.
WEBFLOW_TOKEN=
